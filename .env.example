# Copy this file to .env and fill in your Neon connection string
# Get your OpenAI API key for ChatGPT models to work
OPENAI_API_KEY=your_openai_api_key_here
# Get it from: Neon dashboard → your project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Get it from: Duffel dashboard -> Developers -> Access Tokens
DUFFEL_API_KEY=your_duffel_api_key_here

# Get it from: StayingAPI dashboard -> API Keys (active hotel search provider)
STAYINGAPI_API_KEY=your_stayingapi_key_here

# Get it from: Langfuse Cloud dashboard -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
# Region host: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US), or
# https://jp.cloud.langfuse.com (Japan) — use your project's actual region host, visible
# in the URL bar of the Langfuse dashboard.
LANGFUSE_HOST=https://cloud.langfuse.com
# Span-export timeout in seconds (langfuse default: 5). Raise it when exporting to a
# distant region, otherwise slow exports fail with "Read timed out" and the spans are
# dropped. Tracing is best-effort, so this never fails a request.
LANGFUSE_TIMEOUT=30
